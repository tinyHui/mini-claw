{
  "name": "mini-claw",
  "version": "0.1.0",
  "description": "Lightweight Telegram bot for persistent AI conversations using Pi",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "pi": "pi",
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@carderne/sandbox-runtime": "^0.0.49",
    "@grammyjs/files": "^1.2.0",
    "@grammyjs/types": "^3.27.3",
    "@mariozechner/pi-coding-agent": "^0.73.1",
    "better-sqlite3": "^12.10.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "grammy": "^1.43.0",
    "perfect-logger": "^3.0.0",
    "telegramify-markdown": "^1.3.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.9.2",
    "@vitest/coverage-v8": "^4.1.8",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.4.1",
    "globals": "^17.6.0",
    "memfs": "^4.57.7",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.0",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": ">=22"
  }
}
