{
  "name": "@mini-claw/growth-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && esbuild src/daemon.ts --bundle --platform=node --format=esm --outfile=dist/daemon.js --external:@earendil-works/*",
    "check": "tsc -p tsconfig.json --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "dev": "MINI_CLAW_CONFIG=config/dev.example.yaml tsx watch --clear-screen=false src/daemon.ts",
    "test": "vitest run",
    "start": "node --max-old-space-size=1024 dist/daemon.js"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.82.1",
    "@earendil-works/pi-coding-agent": "0.82.1"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "drizzle-kit": "0.31.10",
    "drizzle-orm": "0.45.2",
    "drizzle-zod": "0.8.3",
    "esbuild": "0.27.1",
    "typescript": "5.9.3",
    "tsx": "4.23.1",
    "vitest": "4.0.15",
    "yaml": "2.8.1",
    "zod": "4.4.3"
  }
}
